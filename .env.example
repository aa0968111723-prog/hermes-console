# Backend only. Generate NEW credentials; rotate all previously exposed credentials.
# Console is No Login: CONSOLE_USERNAME / CONSOLE_PASSWORD_HASH are unused and must not be required to boot.
CONSOLE_ORIGIN=http://localhost:3000
# Browser never receives this secret; authenticated gateway replaces X-Console-Gateway.
CONSOLE_GATEWAY_SECRET=
# Only isolated loopback development; false for Zeabur/public deployment.
CONSOLE_ALLOW_LOCAL_ACCESS=false
# Persistent private volume; one Console process/replica.
CONSOLE_DATA_DIR=./.data
# Confirm the API domain in Zeabur. No default domain or credential is shipped.
HERMES_API_URL=
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
# Opt in only after verifying image input in the deployed version.
HERMES_IMAGE_INPUT=false
HERMES_CONNECT_TIMEOUT_MS=10000
HERMES_IDLE_TIMEOUT_MS=90000
HERMES_TASK_TIMEOUT_MS=900000
# Loopback contract tests only.
HERMES_ALLOW_LOOPBACK_HTTP=false
# Optional Canva Connect / private MCP bridge. Generate independent NEW secrets.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_BRAND_TEMPLATE_ID=
# Exactly 64 hex characters; retain securely across deployments to decrypt OAuth tokens.
CONSOLE_VAULT_KEY=
# At least 32 random characters, configured only in Hermes and this backend.
MCP_BRIDGE_TOKEN=
# Limits this Console's MCP attempts per task, not other tools inside Hermes.
CONSOLE_MAX_TOOL_CALLS=40
# Require real active task + project scope. False only for isolated administrator contract tests.
MCP_REQUIRE_TASK_CONTEXT=true
# Backend-controlled MCP targets. Never place secret values in this JSON; only env references.
CONSOLE_MCP_SERVERS_JSON=[]
# Optional Tamkang / Instagram / Pinterest. Unconfigured stays Unconfigured.
TKU_MCP_URL=
TKU_MCP_TOKEN=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
