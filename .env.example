# Backend only. Generate NEW credentials; rotate all previously exposed credentials.
# No-login single workspace. Invitation env is dormant and must not block entry.
# Optional comma-separated bootstrap admins for unused multi-user helpers.
CONSOLE_ADMIN_EMAILS=
RESEND_API_KEY=
CONSOLE_EMAIL_FROM=
CONSOLE_REQUIRE_GATEWAY=false
CONSOLE_ORIGIN=http://localhost:3000
# Browser never receives this secret; authenticated gateway replaces X-Console-Gateway.
CONSOLE_GATEWAY_SECRET=
# Set true only after verifying the Hermes profile's memory scope and persistent storage.
# Learning remains user-triggered; a completed task is not proof of persisted memory.
HERMES_LEARNING_SCOPE_VERIFIED=false
# Only isolated loopback development; false for Zeabur/public deployment.
CONSOLE_ALLOW_LOCAL_ACCESS=false
# Persistent private volume; one Console process/replica.
CONSOLE_DATA_DIR=./.data
# Confirm the API domain in Zeabur, or enter the same fields in 設定 → 連線.
# UI values are stored encrypted in CONSOLE_DATA_DIR and override these at runtime.
HERMES_API_URL=
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
# Opt in only after verifying image input in the deployed version.
HERMES_IMAGE_INPUT=false
HERMES_CONNECT_TIMEOUT_MS=10000
HERMES_IDLE_TIMEOUT_MS=90000
HERMES_TASK_TIMEOUT_MS=900000
# Loopback contract tests only.
HERMES_ALLOW_LOOPBACK_HTTP=false
# Optional Canva Connect / private MCP bridge. Generate independent NEW secrets.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_BRAND_TEMPLATE_ID=
# Exactly 64 hex characters; retain securely across deployments to decrypt OAuth tokens.
# If unset, Console writes a one-time key to $CONSOLE_DATA_DIR/vault.key and reuses it.
CONSOLE_VAULT_KEY=
# At least 32 random characters, configured only in Hermes and this backend.
MCP_BRIDGE_TOKEN=
# Limits this Console's MCP attempts per task, not other tools inside Hermes.
CONSOLE_MAX_TOOL_CALLS=40
# Require real active task + project scope. False only for isolated administrator contract tests.
MCP_REQUIRE_TASK_CONTEXT=true
# Backend-controlled MCP targets. Never place secret values in this JSON; only env references.
CONSOLE_MCP_SERVERS_JSON=[]
# Optional Tamkang / Instagram / Pinterest. Unconfigured stays Unconfigured.
# Tamkang URL/token can also be saved from 設定 → 連線 (or exchanged if the MCP origin has /auth/login).
TKU_MCP_URL=
TKU_MCP_TOKEN=
# 訊核即時情報 MCP。必須是 Streamable HTTP 的 /mcp 端點，不能填 GitHub 倉庫網址。
XUNHE_MCP_URL=
XUNHE_MCP_TOKEN=
# 場圖 Atlas MCP. Must be public HTTPS ending in /api/mcp — never localhost or a GitHub repo URL.
# Token must match ATLAS_MCP_TOKEN on the Atlas host. Prefer 設定 → 連線.
ATLAS_MCP_URL=
ATLAS_MCP_TOKEN=
# Lumen 創作台。必須是 Streamable HTTP 的 /api/mcp 端點，不能填 GitHub 倉庫網址。
# Token 至少 32 字元，不要把權杖寫進 CONSOLE_MCP_SERVERS_JSON。
LUMEN_MCP_URL=
LUMEN_MCP_TOKEN=
# Optional. Prefer 設定 → 連線. Token from Zeabur Dashboard → Settings → API Keys.
# Anyone who can open a public Console can overwrite this and mutate deploy env.
ZEABUR_API_TOKEN=
ZEABUR_PROJECT_ID=
ZEABUR_SERVICE_ID=
ZEABUR_ENVIRONMENT_ID=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
